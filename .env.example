# PostgreSQL - use o MESMO provedor/instancia ja usado pelos outros sistemas
# Contaseg (contaseg-analytics, crm-bi-vendas), pra manter a infra centralizada.
# Formato exato esperado (troque usuario/senha/host/porta/nome-do-banco pelos
# dados reais do seu provedor - Neon, Supabase, Railway, RDS, etc. costumam
# te dar essa string pronta no painel deles, geralmente exigindo ?sslmode=require):
DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require

# Trello - board real CONTABILIDADE/FISCAL/DP, lista REGULARIZACAO MALHA FISCAL
# (um unico cartao por proposta, criado uma vez, nunca muda de lista - so
# recebe comentarios/membros). TRELLO_API_KEY e TRELLO_API_TOKEN sao pessoais:
# gere em https://trello.com/power-ups/admin (ou https://trello.com/app-key)
# estando logado com a conta que deve criar os cartoes.
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_LIST_ID=650d8ade7d09c4ffa78f845b

# Anexos (provas de aviso previo) sao gravados como binario direto na tabela
# anexos_proposta do Postgres (coluna bytea) - nao ha diretorio pra configurar.

# So usadas UMA VEZ, na hora de rodar `python -m app.seed` - definem a senha
# inicial da Marli e do Gustavo (nunca ficam no codigo-fonte, so em variavel
# de ambiente). Depois do primeiro seed, pode remover essas duas linhas -
# elas nao sao lidas em nenhum outro momento pelo app.
SEED_SENHA_MARLI=
SEED_SENHA_GUSTAVO=
